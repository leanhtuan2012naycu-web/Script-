local function thongBao(txt)
    pcall(function()
        local n = Instance.new("TextLabel", ScreenGui)
        n.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        n.Position, n.Size = UDim2.new(0.5, -135, 0.05, 0), UDim2.new(0, 270, 0, 32)
        n.Font, n.Text, n.TextColor3, n.TextSize = Enum.Font.SourceSansBold, txt, Color3.new(1,1,1), 12
        Instance.new("UIStroke", n).Color = Color3.fromRGB(100, 150, 255)
        TweenService:Create(n, TweenInfo.new(0.5), {Position = UDim2.new(0.5, -135, 0.1, 0)}):Play()
        task.delay(2.5, function() if n then n:Destroy() end end)
    end)
end

