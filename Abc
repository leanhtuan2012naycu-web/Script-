local rideActive, currentTarget = false, nil
taoNutTab1("Bám đít", 128, function(s) rideActive = s if not s then currentTarget = nil end end)
game:GetService("RunService").RenderStepped:Connect(function()
    if rideActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local root = LocalPlayer.Character.HumanoidRootPart
        if not currentTarget or not currentTarget.Character or not currentTarget.Character:FindFirstChild("HumanoidRootPart") then
            currentTarget = nil
            local minD = math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local d = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < minD then minD = d; currentTarget = p end
                    end
                end
            end
        end
        if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
            root.CFrame = currentTarget.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            root.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

