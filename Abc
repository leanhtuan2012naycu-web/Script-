local function taoShader(name, y, cb)
    local sBtn = Instance.new("TextButton", tabContainers[2])
    sBtn.BackgroundColor3, sBtn.Position, sBtn.Size = Color3.fromRGB(120, 0, 0), UDim2.new(0.04, 0, 0, y), UDim2.new(0.92, 0, 0, 28)
    sBtn.Font, sBtn.Text, sBtn.TextColor3, sBtn.TextSize = Enum.Font.SourceSansBold, name .. ": OFF", Color3.fromRGB(255, 100, 100), 11
    Instance.new("UIStroke", sBtn).Color = Color3.fromRGB(180, 50, 50)
    local st = false
    sBtn.MouseButton1Click:Connect(function()
        st = not st
        sBtn.Text = name .. (st and ": ON" or ": OFF")
        sBtn.TextColor3 = st and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
        cb(st)
    end)
end

